# Financial Statement Extractor - Environment Configuration
# Copy this file to .env and customize as needed

# Default model for all tasks
DEFAULT_MODEL=qwen3.5:397b-cloud

# Model for page detection and data extraction (overrides DEFAULT_MODEL)
# EXTRACTION_MODEL=qwen3.5:9b

# Model for LLM-as-Judge evaluation (overrides DEFAULT_MODEL)
# EVALUATION_MODEL=qwen3.5:9b

# Enable VLM verification (true/false)
# USE_VLM_VERIFICATION=false

# Enable observability and metrics logging (true/false)
# ENABLE_OBSERVABILITY=true

# Bearer token required by the MCP server (mcp_server/server.py). Requests
# without a matching "Authorization: Bearer <token>" header get a 401 —
# required before exposing the server via a tunnel.
# MCP_API_KEY=change-me

# Embedding model used for RAG-assisted CoA retrieval (Ollama)
# EMBEDDING_MODEL=nomic-embed-text

# Enable RAG-assisted CoA retrieval in the categorizer instead of dumping
# the full Chart of Accounts into every prompt (true/false)
# USE_RAG_COA_RETRIEVAL=false

# --- OAuth (optional) ---
# Set OAUTH_CLIENT_ID to enable a real OAuth 2.1 authorization-code + PKCE
# flow for clients that only support OAuth (e.g. Claude Desktop's Connectors
# UI) instead of a static bearer token. MCP_API_KEY keeps working unchanged
# either way. All three are required together when OAuth is enabled.
# OAUTH_CLIENT_ID=change-me
# OAUTH_CLIENT_SECRET=change-me
# MCP_PUBLIC_URL=https://your-tunnel.trycloudflare.com
# OAUTH_REDIRECT_URI=https://claude.ai/api/mcp/auth_callback
